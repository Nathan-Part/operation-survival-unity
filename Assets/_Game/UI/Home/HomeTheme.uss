/* Variables de thème + classes partagées par tout l'accueil (premier UI Toolkit du projet).
   Couleurs actées phase 5 : violet #7c4dff, or #ffd15c ; raretés = EconomyConfig.rarities. */

:root {
    --color-purple: #7c4dff;
    --color-purple-dark: #5b32c2;
    --color-blue: #4f9dff;
    --color-gold: #ffd15c;
    /* Playtest Phase 5.1 (2026-07-09) : le web a des cartes CLAIRES sur fond photo, pas des
       cartes sombres — le theme etait invente a l'envers en Phase 5. --color-bg-card n'est
       plus utilise (TacticalPanel dessine son propre fond, cf. Tactical/TacticalPanel.cs). */
    --color-border: rgba(124, 77, 255, 0.25);
    --color-text: #171a26;
    --color-text-dim: #5b6272;
    --rarity-common: #9aa3b2;
    --rarity-rare: #4f9dff;
    --rarity-epic: #b066ff;
    --rarity-legendary: #ffb02e;
}

.hidden {
    display: none;
}

/* Le fond/bordure/coin coupe des cartes viennent desormais de TacticalPanel (Painter2D) —
   cette classe ne fournit plus que l'espacement interne, appliquee en plus du composant. */
.tac-card {
    padding: 14px;
}

.chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.9);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 999px;
    padding: 4px 12px;
    margin-left: 6px;
    color: var(--color-text);
    font-size: 12px;
}

.eyebrow {
    color: var(--color-text-dim);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.gold-text {
    color: var(--color-gold);
}

.rarity-common {
    color: var(--rarity-common);
}

.rarity-rare {
    color: var(--rarity-rare);
}

.rarity-epic {
    color: var(--rarity-epic);
}

.rarity-legendary {
    color: var(--rarity-legendary);
}

/* Polices Barlow (Task 1) — repli police par défaut si les TTF sont absents (pas de plantage USS). */
Label, Button {
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/Barlow-Regular.ttf");
}

.title-word, .deploy-title, .tile-title, .rank-label, .stat-value, .card-title, .char-name {
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

.eyebrow, .intel-key, .intel-value, .stat-sub, .tile-subtitle, .subtitle-hero, .objectif-text {
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/Barlow-SemiBold.ttf");
}
