/* Panneau Boutique (Task 11, shell + onglet Armes ; contenu cloné depuis ShopPanel.uxml dans
   #shop-panel). Le perso 3D lobby (et le modèle héros de l'onglet Armes) doivent rester visibles
   par transparence : #shop-panel a un fond plus clair que .panel (settings/map/loadout, opaque à
   85%) pour laisser passer la scène 3D derrière — parité web (vitrine boutique = scène éclairée,
   pas un simple dialogue par-dessus un fond noir). */

/* Aucun voile : la vitrine 3D reste à pleine luminosité derrière l'UI (parité shop-guns.png —
   l'ancien voile sombre à 40% délavait tout l'écran, constat capture 2026-07-10). */
#shop-panel {
    background-color: rgba(0, 0, 0, 0);
}

/* La boutique reste sur des cartes SOMBRES translucides (vitrine 3D derriere, pas une photo claire
   comme le lobby) : re-declare les variables de texte/fond localement plutot que d'heriter du theme
   clair de HomeTheme.uss (playtest Phase 5.1, 2026-07-09 — la boutique garde son propre habillage). */
.shop-card {
    --color-text: #eef1f8;
    --color-text-dim: #9aa3b2;
    --color-bg-card: rgba(18, 20, 32, 0.82);
    --color-border: rgba(255, 255, 255, 0.1);
    width: 92%;
    height: 88%;
    flex-direction: column;
}

.shop-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

/* "// ARMURERIE" violet en haut-gauche (parité shop-guns.png). */
.shop-title-eyebrow {
    color: var(--color-purple);
    font-size: 13px;
    letter-spacing: 3px;
}

.shop-topbar-right {
    flex-direction: row;
    align-items: center;
}

/* Carte crédits blanche avec carré ⊕ violet (parité shop-guns.png — remplace la pilule emoji). */
.shop-credits-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 10px;
    padding: 6px 14px 6px 6px;
    margin-right: 10px;
}

.shop-credits-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background-color: rgb(103, 58, 235);
    margin-right: 10px;
}

.shop-credits-value {
    color: #171a26;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

/* Croix de fermeture : carré blanc (parité shop-guns.png). */
.shop-close-btn {
    width: 44px;
    height: 44px;
    background-color: rgba(255, 255, 255, 0.95);
    border-width: 0;
    border-radius: 10px;
    color: #171a26;
    font-size: 24px;
    -unity-font-style: bold;
    padding: 0;
    -unity-text-align: middle-center;
}

.shop-body {
    flex-grow: 1;
    flex-direction: row;
}

/* Flèches Précédent/Suivant : gros carrés blancs de part et d'autre de la vitrine 3D
   (parité shop-guns.png). Le wrapper est un overlay non cliquable, les boutons oui. */
.shop-nav {
    position: absolute;
    left: 210px;
    right: 330px;
    top: 35%;
    flex-direction: row;
    justify-content: space-between;
}

.shop-arrow {
    width: 56px;
    height: 56px;
    background-color: rgba(255, 255, 255, 0.95);
    border-width: 0;
    border-radius: 12px;
    color: #171a26;
    font-size: 30px;
    -unity-font-style: bold;
    padding: 0;
    -unity-text-align: middle-center;
}

/* Sidebar : cartes blanches séparées, icône + libellé condensé, onglet actif violet
   (parité shop-guns.png — plus une colonne pleine avec liste plate). */
.shop-rail {
    width: 190px;
    flex-direction: column;
    margin-right: 14px;
}

.shop-tab {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.94);
    border-width: 0;
    border-radius: 10px;
    padding: 10px 12px;
    margin-bottom: 8px;
    -unity-text-align: middle-left;
}

.shop-tab-icon {
    width: 24px;
    height: 24px;
    margin-right: 10px;
}

.shop-tab-label {
    color: #232838;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

.shop-tab.on {
    background-color: var(--color-purple);
}

.shop-tab.on .shop-tab-label {
    color: white;
}

.shop-content {
    flex-grow: 1;
    flex-direction: column;
}

.shop-tab-content {
    flex-grow: 1;
    flex-direction: column;
}

.shop-stub {
    align-items: center;
    justify-content: center;
}

.shop-stub-label {
    color: var(--color-text-dim);
    font-size: 16px;
}

.shop-hero-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

/* Pas de fond : le texte flotte au-dessus de la vitrine 3D. Textes SOMBRES sur le décor clair
   (parité shop-guns.png — le hero web est en navy sur la photo lumineuse). */
.shop-hero {
    width: 380px;
}

.shop-hero-eyebrow {
    color: var(--color-purple);
    letter-spacing: 3px;
}

.shop-wname-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.shop-wname {
    color: #171a26;
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 12px;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

/* Badge de rareté : contour coloré sur fond transparent (parité shop-guns.png), la couleur du
   texte vient de .rarity-* ; le contour est décliné par rareté ci-dessous. */
.rarity-badge {
    background-color: rgba(255, 255, 255, 0.55);
    border-width: 1px;
    border-color: rgba(23, 26, 38, 0.3);
    border-radius: 4px;
    padding: 2px 10px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 8px;
}

.rarity-badge.rarity-common { border-color: var(--rarity-common); }
.rarity-badge.rarity-rare { border-color: var(--rarity-rare); }
.rarity-badge.rarity-epic { border-color: var(--rarity-epic); }
.rarity-badge.rarity-legendary { border-color: var(--rarity-legendary); }

.shop-rating {
    color: var(--color-purple);
    font-size: 15px;
    -unity-font-style: bold;
}

.shop-desc {
    color: #454c5e;
    font-size: 14px;
    margin-top: 8px;
    white-space: normal;
    max-width: 340px;
}

/* Panneau statistiques NOIR (parité shop-guns.png — carte sombre découpée sur le décor clair). */
.shop-stats-panel {
    width: 310px;
    background-color: rgba(10, 11, 20, 0.94);
    border-width: 0;
    border-radius: 6px;
    padding: 16px;
}

/* Onglet Personnage : panneau stats en BAS-CENTRE, boutons côte à côte (parité shop-perso.png —
   l'onglet Armes garde son panneau à droite comme shop-guns.png). */
/* Centrage garanti : left 50% + marge négative de width/2 (le translate -50% et le
   margin:auto en absolu ne centraient pas de façon fiable — playtest 2026-07-10, point 9).
   L'élément est un enfant direct de l'onglet (pleine largeur), voir ShopPanel.uxml. */
#shop-char-stats-panel {
    position: absolute;
    bottom: 24px; /* en bas comme le web — le carrousel de persos est masqué (parité shop-perso.png) */
    left: 50%;
    margin-left: -270px;
    width: 540px;
}

#shop-char-stats-panel .sp-btns {
    flex-direction: row;
    justify-content: center;
}

#shop-char-stats-panel .shop-cta,
#shop-char-stats-panel .shop-badge {
    margin-left: 6px;
    margin-right: 6px;
    min-width: 170px;
}

.sp-h-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.sp-h-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
}

.sp-h {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.stat-label {
    width: 74px;
    color: #9aa3b2;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.stat-bar {
    flex-grow: 1;
    height: 7px;
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: 3px;
    overflow: hidden;
    margin-left: 6px;
    margin-right: 6px;
}

.stat-bar-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(129, 90, 255);
}

.stat-value-shop {
    width: 44px;
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* Sous-panneau d'amélioration (parité amelioration.png) : encadré sous les barres de stats,
   une ligne par stat — nom, pastilles carrées (remplie = niveau acquis), bouton violet ⊕ prix. */
.shop-upgrades {
    margin-top: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16); /* cadre subtil sur panneau noir (amelioration.png) */
    border-radius: 6px;
    padding: 10px 12px;
}

.upg-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.upg-name {
    color: white; /* panneau stats noir — pas var(--color-text), illisible ici */
    font-size: 14px;
    min-width: 108px;
}

.upg-pips {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
}

.upg-pip {
    width: 13px;
    height: 13px;
    margin-right: 6px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.18);
}

.upg-pip.filled {
    background-color: var(--color-purple);
}

.upg-buy {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: var(--color-purple);
    border-width: 0;
    border-radius: 5px;
    color: white;
    padding: 6px 14px;
    font-size: 13px;
    -unity-font-style: bold;
    min-width: 74px;
}

.upg-buy-amount {
    color: white;
    margin-left: 5px;
    -unity-font-style: bold;
}

/* Pseudo-états du thème par défaut (cf. .panel-back, Home.uss) : figer le violet. */
.upg-buy:hover { background-color: var(--color-purple-dark); }
.upg-buy:active { background-color: var(--color-purple-dark); }
.upg-buy:disabled { opacity: 0.45; }

.sp-btns {
    flex-direction: column;
    margin-top: 14px;
}

.shop-cta {
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    color: white;
    padding: 10px 14px;
    margin-top: 8px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.shop-cta.buy {
    background-color: var(--color-gold);
    border-color: var(--color-gold);
    color: #201a08;
}

.shop-cta.ameliorer {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

.shop-badge {
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(78, 209, 128, 0.7);
    border-radius: 6px;
    color: #4ed180;
    padding: 9px 14px;
    margin-top: 8px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Plus de panneau conteneur : les chips et les cartes flottent sur le décor (parité shop-guns.png). */
.shop-bottombar {
    margin-top: 12px;
}

.shop-wcats {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 10px;
}

/* Chips de catégories : carrés blancs, texte condensé sombre, actif violet (parité shop-guns.png). */
/* Sous-onglets : GRANDE taille permanente (point 5 feedback n°3 — la taille perçue au clic
   doit être l'état de base). Pseudo-états épinglés comme .panel-back (Home.uss:535-544) :
   le thème Unity par défaut modifie l'apparence au survol/clic/focus sinon. */
.subtab {
    background-color: rgba(255, 255, 255, 0.92);
    border-width: 1px;
    border-color: rgba(23, 26, 38, 0.15);
    border-radius: 4px;
    color: #232838;
    padding: 12px 28px;
    margin-right: 8px;
    margin-bottom: 4px;
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

.subtab:hover { background-color: rgb(255, 255, 255); border-color: rgba(23, 26, 38, 0.15); color: #232838; }
.subtab:active { background-color: rgb(255, 255, 255); border-color: rgba(23, 26, 38, 0.15); color: #232838; }
.subtab:focus { background-color: rgba(255, 255, 255, 0.92); border-color: rgba(23, 26, 38, 0.15); color: #232838; }

.subtab.on {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

.subtab.on:hover { background-color: var(--color-purple); border-color: var(--color-purple); color: white; }
.subtab.on:active { background-color: var(--color-purple); border-color: var(--color-purple); color: white; }
.subtab.on:focus { background-color: var(--color-purple); border-color: var(--color-purple); color: white; }

.shop-carousel {
    height: 170px;
}

/* Etat "non possede" porte par la classe de base (opacity 0.6), .owned remonte a 1 — le selecteur
   :not() n'est PAS supporte par l'importeur USS de cette version d'editeur : il ne degradait pas
   juste la regle, il invalidait TOUT le fichier Shop.uss a l'import (importedWithErrors=true,
   aucun style boutique applique depuis la Phase 5 — c'etait la vraie cause racine du
   "boutons partout" du playtest de Nathan). Diagnostic 2026-07-10. */
.wcard {
    width: 148px;
    height: 158px;
    background-color: rgba(13, 14, 24, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 10px;
    margin-right: 10px;
    align-items: flex-start;
    justify-content: space-between;
    opacity: 0.7;
}

.wcard.active {
    border-color: var(--color-purple);
    border-width: 2px;
}

.wcard.owned {
    opacity: 1;
}

.wcard-top {
    align-items: flex-start;
}

.wcard-name {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

/* Rareté sous le nom dans la carte (parité shop-guns.png), colorée par .rarity-*. */
.wcard-rarity {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-top: 1px;
}

.wcard-thumb {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    align-self: stretch;
}

.wcard-glyph {
    font-size: 28px;
}

.thumb-img {
    width: 52px;
    height: 52px;
}

.wcard-foot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

.wcard-rating {
    color: var(--color-gold);
    font-size: 11px;
    -unity-font-style: bold;
}

.wcard-lock {
    font-size: 10px;
}

/* Onglet Accessoires (Task 13) : entête + 3 sous-onglets (Masque/Costume/Danses), grille de tuiles
   façon .wcard mais plus grandes (image accessoire lisible) + barre d'achat unique sous la grille
   (masque/costume) ou compteur + tuiles autonomes (danses). */
/* Panneau latéral droit blanc pour les onglets à grille (parité shop-accessoires.png :
   Accessoires/Boost/Consommables vivent dans une colonne blanche à droite, le perso 3D
   reste visible au centre). */
/* Élargi 340 -> 600 (playtest 2026-07-10 soir) : plusieurs articles par ligne dans les
   grilles, toujours groupés par rareté (les en-têtes forcent le retour à la ligne). */
.shop-side-panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 600px;
    background-color: rgba(247, 248, 252, 0.95);
    border-radius: 6px;
    padding: 16px;
}

.side-title {
    color: #171a26;
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

.side-underline {
    margin-top: 2px;
    margin-bottom: 10px;
}

.side-hint {
    color: #5b6272;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 8px;
}

.shop-acc-head {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 10px;
}

.shop-wcats-left {
    justify-content: flex-start;
    margin-bottom: 6px;
}

.shop-sub2 {
    color: #5b6272;
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.shop-acc-view {
    flex-grow: 1;
    flex-direction: column;
}

.acc-grid {
    flex-grow: 1;
}

/* En-tete de groupe par rarete (Accessoires/Boost/Consommables) — width 100% force le retour a la
   ligne dans le conteneur en flex-wrap (SetupGridWrap), la couleur vient de .rarity-* (ApplyRarityClass). */
.rarity-group-header {
    width: 100%;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-top: 10px;
    margin-bottom: 4px;
}

/* Tuiles CLAIRES : elles vivent dans le panneau latéral blanc (parité shop-accessoires.png). */
.acctile {
    width: 145px;
    height: 150px;
    background-color: rgba(23, 26, 38, 0.05);
    border-width: 1px;
    border-color: rgba(23, 26, 38, 0.1);
    border-radius: 6px;
    padding: 6px;
    margin-right: 8px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: space-between;
    opacity: 0.6; /* non possede par defaut, .owned remonte a 1 — :not() interdit (voir .wcard) */
}

.acctile.active {
    border-color: var(--color-purple);
    border-width: 2px;
}

.acctile.owned {
    opacity: 1;
}

.acctile-name {
    color: #171a26;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.acctile-thumb {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.acctile-glyph {
    font-size: 32px;
}

.acctile-img {
    width: 64px;
    height: 64px;
}

.acctile-foot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

/* Vignettes RONDES des masques/costumes (point 10, parité shop-accessoires.png /
   shop-accessoires2.png) : grand cercle gris, bordure épaisse colorée par rareté,
   coche verte sur l'article équipé. S'applique PAR-DESSUS .acctile (les danses
   gardent la tuile rectangulaire). */
/* Playtest 2026-07-10 soir : cercles agrandis (116 -> 145, on ne voyait pas les articles).
   Feedback n°3 point 4 : 145 -> 165 + marges aérées (référence : cercle ≈ 27 % de la
   largeur du panneau sur shop-accessoires2.png). */
.acctile.acc-round {
    width: 165px;
    height: 165px;
    border-radius: 83px;
    background-color: rgb(208, 211, 220);
    border-width: 3px;
    border-color: rgb(154, 163, 178);
    padding: 0;
    margin: 14px 16px;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.acc-round.rar-common { border-color: rgb(154, 163, 178); }
.acc-round.rar-rare { border-color: rgb(79, 157, 255); }
.acc-round.rar-epic { border-color: rgb(176, 102, 255); }
.acc-round.rar-legendary { border-color: rgb(255, 176, 46); }

.acc-round.active {
    border-width: 4px;
}

.acc-round .acctile-img {
    width: 124px;
    height: 124px;
}

.acc-check {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: rgb(46, 204, 113);
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Cadenas EN HAUT-DROITE comme la coche (playtest 2026-07-10 soir — parité exemple). */
.acc-lock {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgb(120, 126, 140);
    align-items: center;
    justify-content: center;
}

/* En-tête de section par rareté : label encadré + ligne horizontale colorée (couleurs
   posées en inline depuis le code, table RarityColorOf). */
.rarity-header-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 10px;
    margin-bottom: 4px;
}

.rarity-header-label {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-width: 1px;
    padding: 2px 10px;
}

.rarity-header-line {
    flex-grow: 1;
    height: 2px;
    margin-left: 8px;
}

/* Cellule colonne des grilles Boost/Consommables (point 11) : cercle + nom + stat + action.
   Largeur calée pour 3 cellules par ligne dans le panneau de 600px. */
.gridcell {
    width: 170px;
    align-items: center;
    margin-bottom: 12px;
}

.gridcell .acctile.acc-round {
    margin: 6px 0;
}

.gridcell-name {
    color: #171a26;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 2px;
}

.gridcell-stat {
    color: rgba(23, 26, 38, 0.6);
    font-size: 10px;
    margin-bottom: 4px;
}

.acctile-rarity {
    font-size: 9px;
    padding: 1px 6px;
    margin-right: 0;
}

.acctile-lock {
    font-size: 10px;
}

/* Barre d'achat : pied du panneau latéral blanc (parité shop-accessoires.png — bouton ÉQUIPER
   pleine largeur clair, nom de l'article au-dessus). */
.acc-buybar {
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(23, 26, 38, 0.12);
    padding: 10px 14px;
    margin-top: 8px;
    flex-direction: column;
    align-items: stretch;
}

/* web acc-buy-bar (main.js:1592-1601) : bouton/badge SEUL, pleine largeur, texte centré
   (point 4 feedback n°3 — la ligne nom+rareté a été retirée de l'UXML). */
.acc-buybar .shop-cta,
.acc-buybar .shop-badge {
    width: 100%;
    -unity-text-align: middle-center;
    justify-content: center;
}

.acc-buybar .shop-cta {
    background-color: rgba(255, 255, 255, 0.9);
    border-color: rgba(23, 26, 38, 0.25);
    color: #171a26;
}

.acc-buybar .shop-badge {
    background-color: rgba(255, 255, 255, 0.9);
    border-width: 1px;
    border-color: rgba(23, 26, 38, 0.12);
    color: rgb(46, 204, 113); /* « ✓ Équipé » vert centré, comme la capture */
}

.acc-buybar .shop-cta.buy {
    background-color: var(--color-gold);
    border-color: var(--color-gold);
    color: #201a08;
}

/* Tuile de danse (Task 13) : pas de barre d'achat partagée, chaque tuile porte ses propres boutons
   (▶ + Acheter/Choisir) sur une ligne dédiée en pied de tuile. */
.dcard {
    height: 168px;
}

.dcard-btnrow {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    margin-top: 4px;
}

.dcard-play {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    padding: 4px 10px;
    margin-right: 4px;
    font-size: 11px;
}

.dcard-play.on {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

/* Onglets Boost + Consommables (Task 14) : grilles de tuiles façon .acctile, un peu plus hautes
   pour loger une ligne de stat/stock (.acctile-stat) au-dessus du pied de tuile, et un bouton
   d'action pleine largeur (.tile-action) dont le sens change avec l'état — jamais de barre
   d'achat partagée (contrairement à l'onglet Accessoires) : chaque tuile est autonome. */
.boosttile,
.constile {
    height: 176px;
}

.acctile-stat {
    color: var(--color-gold);
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.tile-action {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.9);
    border-width: 1px;
    border-color: rgba(23, 26, 38, 0.2);
    border-radius: 4px;
    color: #171a26;
    padding: 4px 10px;
    margin-top: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tile-action.buy {
    background-color: var(--color-gold);
    border-color: var(--color-gold);
    color: #201a08;
}

.tile-action.on {
    background-color: rgba(78, 209, 128, 0.2);
    border-color: rgba(78, 209, 128, 0.6);
    color: #6ee7a0;
}
