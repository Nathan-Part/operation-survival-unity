/* Panneau Comment jouer (Task 15, contenu cloné depuis HowToPanel.uxml dans #howto-panel). */

.howto-card {
    width: 760px;
    max-height: 86%;
}

.howto-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 10px;
}

.howto-tab {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 999px;
    color: var(--color-text-dim);
    padding: 6px 14px;
    margin-right: 6px;
    margin-bottom: 6px;
    font-size: 11px;
}

.howto-tab.on {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
    -unity-font-style: bold;
}

.howto-body {
    max-height: 480px;
}

.howto-page {
    flex-direction: column;
}

.howto-key-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 3px;
}

.howto-key-action {
    color: var(--color-text);
    font-size: 12px;
    white-space: normal;
    flex-shrink: 1;
}

.howto-key-kbd {
    color: var(--color-text-dim);
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 2px 8px;
    margin-left: 10px;
    -unity-text-align: middle-right;
}

.howto-group-title {
    color: var(--color-text);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 4px;
}

.howto-item {
    color: var(--color-text-dim);
    font-size: 12px;
    margin-top: 2px;
    white-space: normal;
}

.howto-bullet {
    color: var(--color-text-dim);
    font-size: 12px;
    margin-top: 4px;
    white-space: normal;
}

.howto-paragraph {
    color: var(--color-text-dim);
    font-size: 12px;
    margin-top: 6px;
    white-space: normal;
}
