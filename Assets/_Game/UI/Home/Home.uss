/* Layout du lobby (approximation USS du CSS web — clip-path "tactique" non reproduit, spec §4.6). */

.home-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lobby {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px 36px;
}

.hub-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.hub-col {
    width: 30%;
}

.hub-center {
    width: 38%;
    align-items: center;
}

.hub-status {
    align-items: flex-end;
}

.rank-label {
    color: var(--color-text);
    font-size: 18px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.rank-bar {
    height: 6px;
    background-color: rgba(23, 26, 38, 0.1);
    border-radius: 3px;
    margin-top: 6px;
    overflow: hidden;
}

.rank-bar-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-purple);
}

.title-row {
    flex-direction: row;
    justify-content: center;
}

.title-word {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-right: 8px;
}

.title-gradient {
    color: var(--color-purple);
}

.subtitle {
    color: var(--color-text-dim);
    font-size: 13px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.chip-row {
    flex-direction: row;
    justify-content: flex-end;
}

.button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

.icon-button {
    margin-left: 8px;
    background-color: rgba(255, 255, 255, 0.9);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 6px 12px;
}

.hub-main {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 20px;
}

.hub-main-col {
    flex-direction: column;
    margin-left: 18px;
    margin-right: 18px;
}

.hub-card-slot {
    margin-bottom: 14px;
    width: 260px;
}

.intel-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.intel-key {
    color: var(--color-text-dim);
    font-size: 12px;
}

.intel-value {
    color: var(--color-text);
    font-size: 12px;
    -unity-font-style: bold;
}

/* Colonne centrale : le selecteur de perso se pose en bas, au pied du socle (parite homepage.png) —
   sans etirement vertical il flottait au centre, sur la tete du perso (playtest 2026-07-10). */
.hub-deploy-col {
    align-items: center;
    justify-content: flex-end;
    align-self: stretch;
    padding-bottom: 8px;
}

/* Fond/coins coupes/degrade fournis par TacticalButton (Painter2D) — cf. Tactical/TacticalButton.cs. */
.deploy-button {
    width: 260px;
    height: 120px;
    justify-content: center;
    align-items: center;
    margin-bottom: 14px;
}

/* Textes secondaires du Deployer : blancs sur le degrade violet (les couleurs par defaut
   .eyebrow/.subtitle sont pensees pour les cartes claires — illisibles sur violet, 2026-07-10). */
.deploy-button .eyebrow {
    color: rgba(255, 255, 255, 0.75);
}

.deploy-button .subtitle {
    color: rgba(255, 255, 255, 0.85);
}

.deploy-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    margin-top: 4px;
    margin-bottom: 4px;
}

.char-selector {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 999px;
    padding: 6px 18px;
}

.char-arrow {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: transparent;
    color: var(--color-text);
}

.char-name {
    color: var(--color-text);
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 10px;
    margin-right: 10px;
}

.char-dots {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(23, 26, 38, 0.3);
    margin-left: 3px;
    margin-right: 3px;
}

.dot-active {
    background-color: var(--color-purple);
}

.objectif-thumb {
    height: 90px;
    background-image: url("/Assets/_Game/Art/UI/objectif.jpg");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 8px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.objectif-text {
    color: var(--color-text-dim);
    font-size: 11px;
    white-space: normal;
}

.hub-deploy {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 20px;
}

/* Fond/coins coupes fournis par TacticalButton (Painter2D) pour les .hub-tile transformees en boutons tactiques. */
.hub-tile {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 6px;
    padding: 10px;
    align-items: center;
}

/* tile-indicator (Difficulté) reste une VisualElement simple (pas cliquable) : garde un fond leger. */
.hub-indicator-bg {
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--color-border);
}

.tile-title {
    color: var(--color-text);
    font-size: 14px;
    -unity-font-style: bold;
}

.tile-subtitle {
    color: var(--color-text-dim);
    font-size: 10px;
    margin-top: 2px;
}

.hub-indicator {
    opacity: 0.6;
}

.panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 7, 12, 0.85);
    justify-content: center;
    align-items: center;
}

/* Panneau Réglages (Task 8, contenu cloné depuis SettingsPanel.uxml dans #settings-panel). */
.settings-card {
    width: 420px;
}

.panel-title {
    color: var(--color-text);
    font-size: 26px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 14px;
}

.set-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
}

.set-row-column {
    align-items: flex-start;
}

.set-label {
    color: var(--color-text);
    font-size: 13px;
}

.set-label-group {
    flex-direction: column;
}

.set-label-sub {
    color: var(--color-text-dim);
    font-size: 10px;
}

.set-slider {
    width: 160px;
    margin-left: 10px;
    margin-right: 10px;
}

.set-val {
    color: var(--color-text);
    font-size: 12px;
    -unity-font-style: bold;
    min-width: 42px;
    -unity-text-align: middle-right;
}

.set-toggle {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 6px 14px;
}

.set-toggle.toggle-on {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

.set-diff {
    flex-direction: row;
    margin-top: 6px;
}

.set-diff-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 6px 12px;
    margin-right: 8px;
}

.set-diff-btn.diff-active {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

/* Playtest Phase 5.1 (2026-07-09) : bouton Retour violet pleine largeur en bas de la modale
   (parite modal-map.png), au lieu d'un petit bouton gris aligne a gauche. */
.panel-back {
    margin-top: 18px;
    background-color: var(--color-purple);
    border-width: 0;
    border-radius: 8px;
    color: white;
    -unity-font-style: bold;
    padding: 10px 14px;
    align-self: stretch;
    -unity-text-align: middle-center;
}

/* Panneau Map (Task 9, contenu cloné depuis MapPanel.uxml dans #map-panel). */
.map-card {
    width: 480px;
}

.panel-intro {
    color: var(--color-text-dim);
    font-size: 12px;
    margin-top: 2px;
    margin-bottom: 14px;
    white-space: normal;
}

.map-list {
    flex-direction: row;
    justify-content: space-between;
}

.map-item {
    width: 210px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--color-border);
    padding: 10px;
    align-items: center;
}

.map-item-disabled {
    opacity: 0.5;
}

.map-thumb {
    width: 100%;
    height: 110px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    -unity-background-scale-mode: scale-and-crop;
    margin-bottom: 8px;
}

.map-thumb-utopia {
    background-image: url("/Assets/_Game/Art/UI/background.png");
}

.map-thumb-urban {
    /* Pas d'art dédié tant que la map n'est pas livrée (MapRules.IsAvailable == false) :
       reprend explicitement le fond neutre de .map-thumb en attendant une vignette réelle. */
    background-color: rgba(255, 255, 255, 0.08);
}

.map-name {
    color: var(--color-text);
    font-size: 15px;
    -unity-font-style: bold;
}

.map-sub {
    color: var(--color-text-dim);
    font-size: 11px;
    margin-top: 2px;
}

.map-sub.map-sub-current {
    color: var(--color-gold);
}

.map-badge {
    color: var(--color-text);
    font-size: 10px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 999px;
    padding: 2px 10px;
    margin-top: 4px;
}

/* Panneau Série de points / loadout (Task 10, contenu cloné depuis LoadoutPanel.uxml dans #loadout-panel). */
.loadout-card {
    width: 620px;
}

.loadout-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.loadout-item {
    width: 180px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--color-border);
    padding: 10px;
    margin: 6px;
    align-items: center;
}

.loadout-name {
    color: var(--color-text);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.loadout-sub {
    color: var(--color-text-dim);
    font-size: 11px;
    margin-top: 2px;
    margin-bottom: 8px;
}

.loadout-toggle {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 6px 10px;
    font-size: 11px;
}

.loadout-toggle.toggle-on {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

/* Overlay plein écran anti-flash affiché avant le chargement de la map (parité web §3.7). */
.boot-loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 7, 12, 0.96);
    justify-content: center;
    align-items: center;
}

.boot-loading-label {
    color: var(--color-text);
    font-size: 26px;
    -unity-font-style: bold;
}

/* Barre de progression reelle (Phase 5.1, G1) — remplace le simple voile anti-flash sans retour
   visuel pendant l'attente de LoadSceneAsync. */
.boot-loading-track {
    width: 420px;
    height: 10px;
    margin-top: 18px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 5px;
    overflow: hidden;
}

.boot-loading-bar {
    width: 0%;
    height: 100%;
    background-color: var(--color-purple);
}
