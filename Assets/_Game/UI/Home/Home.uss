/* Layout du lobby — parité homepage.png (passe 2026-07-10) : typographie condensée majuscules,
   cartes ancrées aux bords, icônes TacticalIcon dans des carrés indigo. Référence 1920x1080. */

.home-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lobby {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px 40px;
}

.hub-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

/* Carte opérateur (haut-gauche) : icône personne + RANG en violet, comme homepage.png. */
.op-card {
    flex-direction: row;
    align-items: center;
    width: 330px;
}

.op-text {
    flex-grow: 1;
    margin-left: 14px;
}

.rank-label {
    color: var(--color-purple);
    font-size: 30px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.rank-bar {
    height: 6px;
    background-color: rgba(23, 26, 38, 0.12);
    border-radius: 3px;
    margin-top: 6px;
    overflow: hidden;
}

.rank-bar-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-purple);
}

/* Titre central : OPÉRATION / SURVIE empilés, énormes (parité homepage.png). */
.hub-center {
    align-items: center;
    flex-grow: 1;
}

.eyebrow-purple {
    color: var(--color-purple);
    letter-spacing: 4px;
}

.title-word {
    font-size: 62px;
    -unity-font-style: bold;
    color: var(--color-text);
    letter-spacing: 2px;
    margin-top: -6px;
}

.title-gradient {
    color: var(--color-purple);
    margin-top: -18px;
}

.subtitle {
    color: var(--color-text-dim);
    font-size: 13px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.subtitle-hero {
    color: var(--color-text);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-top: 0;
}

/* Statuts haut-droite : cartes crédits/vague + boutons carrés réglages/aide. */
.hub-status {
    flex-direction: row;
    align-items: flex-start;
}

.stat-card {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
    padding: 10px 14px;
}

.stat-text {
    margin-left: 10px;
}

.stat-value {
    color: var(--color-text);
    font-size: 26px;
    -unity-font-style: bold;
}

.stat-sub {
    color: var(--color-text-dim);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-top: 1px;
}

.icon-button {
    margin-left: 10px;
    width: 46px;
    height: 46px;
    background-color: rgba(255, 255, 255, 0.94);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    justify-content: center;
    align-items: center;
    padding: 0;
}

.icon-button-text {
    font-size: 20px;
    -unity-font-style: bold;
}

/* Carrés d'icônes indigo (le glyphe blanc est un TacticalIcon monté en code — cf. HomeController). */
.icon-square {
    width: 58px;
    height: 58px;
    border-radius: 10px;
    background-color: rgb(40, 32, 74);
    flex-shrink: 0;
}

.icon-square-sm {
    width: 46px;
    height: 46px;
}

/* Les cartes crédits/vague du haut-droit ont des carrés VIOLETS (homepage.png), pas indigo. */
.stat-card .icon-square {
    background-color: rgb(103, 58, 235);
}

.icon-square-deploy {
    width: 52px;
    height: 52px;
    background-color: rgba(24, 16, 54, 0.9);
}

.icon-plain {
    width: 30px;
    height: 30px;
}

.purple-text {
    color: var(--color-purple);
}

/* En-tête de carte : petite icône violette + titre condensé sombre. */
.card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.card-header-icon {
    width: 22px;
    height: 22px;
    margin-right: 8px;
}

.card-title {
    color: var(--color-text);
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* Zone principale : Intel/Équipement collés à gauche, Déployer/Objectif à droite. */
.hub-main {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 16px;
}

.hub-main-col {
    flex-direction: column;
}

.hub-card-slot {
    margin-bottom: 16px;
    width: 330px;
    padding: 18px;
}

.intel-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 7px;
}

.intel-key {
    color: rgb(42, 48, 64);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.intel-value {
    color: var(--color-text);
    font-size: 14px;
    -unity-font-style: bold;
}

/* Colonne centrale : le selecteur de perso se pose en bas, au pied du socle (parite homepage.png). */
.hub-deploy-col {
    align-items: center;
    justify-content: flex-end;
    align-self: stretch;
    flex-grow: 1;
    padding-bottom: 6px;
}

.hub-main-col-right {
    align-items: flex-end;
}

/* Fond/coins coupes/degrade/rayures fournis par TacticalButton (Painter2D). */
.deploy-button {
    width: 400px;
    height: 150px;
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
}

.deploy-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Textes secondaires du Deployer : blancs sur le degrade violet. */
.deploy-eyebrow {
    color: rgba(255, 255, 255, 0.8);
    letter-spacing: 3px;
}

.deploy-sub {
    color: rgba(255, 255, 255, 0.88);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.deploy-title {
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    letter-spacing: 2px;
    margin-left: 14px;
}

.objectif-card {
    width: 400px;
}

/* Pilule aux proportions homepage.png (point 7) : hauteur fixe, radius = moitié de la
   hauteur (vraie pilule, plus le boudin du radius 999 sur un bloc haut). */
.char-selector {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.95);
    height: 52px;
    border-radius: 26px;
    padding: 0 14px;
    min-width: 330px;
}

.char-center {
    align-items: center;
    flex-grow: 1;
}

.char-arrow {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-text);
    font-size: 20px;
    -unity-font-style: bold;
}

.char-name {
    color: var(--color-text);
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.char-dots {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}

.dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: rgba(23, 26, 38, 0.25);
    margin-left: 3px;
    margin-right: 3px;
}

.dot-active {
    background-color: var(--color-purple);
}

.objectif-thumb {
    height: 130px;
    background-image: url("/Assets/_Game/Art/UI/objectif.jpg");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 8px;
    margin-top: 4px;
    margin-bottom: 10px;
}

.objectif-text {
    color: var(--color-text);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

/* Rangée du bas : 4 tuiles compactes à gauche, carte Difficulté à droite (parité homepage.png —
   les tuiles ne s'étirent plus sur toute la largeur). */
.hub-deploy {
    flex-direction: row;
    justify-content: flex-start;
    align-items: flex-end;
    margin-top: 16px;
}

/* Fond/coins coupes fournis par TacticalButton (Painter2D). */
.hub-tile {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
    padding: 12px 18px 12px 12px;
    flex-shrink: 1; /* jamais coupé : la tuile se comprime plutôt que de sortir de l'écran */
}

.tile-text {
    margin-left: 10px;
    align-items: flex-start;
}

.tile-title {
    color: var(--color-text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tile-subtitle {
    color: var(--color-text-dim);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-top: 1px;
}

/* Carte Difficulté croissante : poussée à droite, texte violet + barres montantes. */
.hub-indicator {
    margin-left: auto;
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    flex-shrink: 0;
}

.hub-indicator .tile-text {
    margin-left: 0;
    margin-right: 12px;
    align-items: flex-start;
}

.icon-diff {
    width: 34px;
    height: 34px;
}

.panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 7, 12, 0.85);
    justify-content: center;
    align-items: center;
}

/* Panneau Réglages (Task 8, contenu cloné depuis SettingsPanel.uxml dans #settings-panel). */
.settings-card {
    width: 420px;
}

.panel-title {
    color: var(--color-text);
    font-size: 26px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 14px;
}

.set-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
}

.set-row-column {
    align-items: flex-start;
}

.set-label {
    color: var(--color-text);
    font-size: 13px;
}

.set-label-group {
    flex-direction: column;
}

.set-label-sub {
    color: var(--color-text-dim);
    font-size: 10px;
}

.set-slider {
    width: 160px;
    margin-left: 10px;
    margin-right: 10px;
}

.set-val {
    color: var(--color-text);
    font-size: 12px;
    -unity-font-style: bold;
    min-width: 42px;
    -unity-text-align: middle-right;
}

.set-toggle {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 6px 14px;
}

.set-toggle.toggle-on {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

.set-diff {
    flex-direction: row;
    margin-top: 6px;
}

.set-diff-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 6px 12px;
    margin-right: 8px;
}

.set-diff-btn.diff-active {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

/* Playtest Phase 5.1 (2026-07-09) : bouton Retour violet pleine largeur en bas de la modale
   (parite modal-map.png), au lieu d'un petit bouton gris aligne a gauche. */
.panel-back {
    margin-top: 18px;
    background-color: var(--color-purple);
    border-width: 0;
    border-radius: 8px;
    color: white;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 10px 14px;
    align-self: stretch;
    -unity-text-align: middle-center;
}

/* Les pseudo-états du thème par défaut (.unity-button:hover/:active, fond gris) ont une
   spécificité supérieure à .panel-back seul — sans ces règles le bouton vire au gris lavande
   dès que la souris le survole (constat capture 2026-07-10). */
.panel-back:hover {
    background-color: var(--color-purple-dark);
}

.panel-back:active {
    background-color: var(--color-purple-dark);
}

/* Panneau Map (Task 9, contenu cloné depuis MapPanel.uxml dans #map-panel).
   Parité modal-map.png (2026-07-10) : tout centré, titre condensé énorme + souligné violet,
   tuiles blanches avec carré-icône carte indigo. */
.map-card {
    width: 520px;
    align-items: center;
}

.modal-eyebrow {
    -unity-text-align: middle-center;
    letter-spacing: 4px;
}

.modal-title {
    font-size: 44px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

.modal-title-underline {
    width: 90px;
    height: 4px;
    background-color: var(--color-purple);
    margin-bottom: 12px;
}

.modal-intro {
    -unity-text-align: middle-center;
}

.panel-intro {
    color: var(--color-text-dim);
    font-size: 12px;
    margin-top: 2px;
    margin-bottom: 14px;
    white-space: normal;
}

.map-list {
    flex-direction: row;
    justify-content: space-between;
}

.map-item {
    width: 225px;
    background-color: rgb(238, 240, 246);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(124, 77, 255, 0.15);
    padding: 16px 10px;
    align-items: center;
}

.map-item-icon {
    width: 52px;
    height: 52px;
    margin-bottom: 10px;
}

.map-item-disabled {
    opacity: 0.5;
}

.map-thumb {
    width: 100%;
    height: 110px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    -unity-background-scale-mode: scale-and-crop;
    margin-bottom: 8px;
}

.map-thumb-utopia {
    background-image: url("/Assets/_Game/Art/UI/background.png");
}

.map-thumb-urban {
    /* Pas d'art dédié tant que la map n'est pas livrée (MapRules.IsAvailable == false) :
       reprend explicitement le fond neutre de .map-thumb en attendant une vignette réelle. */
    background-color: rgba(255, 255, 255, 0.08);
}

.map-name {
    color: var(--color-text);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-font-definition: url("/Assets/_Game/Art/UI/Fonts/BarlowCondensed-Bold.ttf");
}

.map-sub {
    color: var(--color-text-dim);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 3px;
}

.map-sub.map-sub-current {
    color: var(--color-purple);
}

.map-badge {
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    background-color: rgba(23, 26, 38, 0.75);
    border-radius: 4px;
    padding: 2px 10px;
    margin-top: 4px;
}

/* Panneau Série de points / loadout (Task 10, contenu cloné depuis LoadoutPanel.uxml dans #loadout-panel). */
.loadout-card {
    width: 620px;
}

.loadout-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.loadout-item {
    width: 180px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--color-border);
    padding: 10px;
    margin: 6px;
    align-items: center;
}

.loadout-name {
    color: var(--color-text);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.loadout-sub {
    color: var(--color-text-dim);
    font-size: 11px;
    margin-top: 2px;
    margin-bottom: 8px;
}

.loadout-toggle {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 6px 10px;
    font-size: 11px;
}

.loadout-toggle.toggle-on {
    background-color: var(--color-purple);
    border-color: var(--color-purple);
    color: white;
}

/* Overlay plein écran anti-flash affiché avant le chargement de la map (parité web §3.7). */
.boot-loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 7, 12, 0.96);
    justify-content: center;
    align-items: center;
}

.boot-loading-label {
    color: white;
    font-size: 26px;
    -unity-font-style: bold;
}

/* Barre de progression reelle (Phase 5.1, G1) — remplace le simple voile anti-flash sans retour
   visuel pendant l'attente de LoadSceneAsync. */
.boot-loading-track {
    width: 420px;
    height: 10px;
    margin-top: 18px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 5px;
    overflow: hidden;
}

.boot-loading-bar {
    width: 0%;
    height: 100%;
    background-color: var(--color-purple);
}
